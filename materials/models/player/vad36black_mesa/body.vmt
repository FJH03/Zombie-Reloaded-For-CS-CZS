"VertexLitGeneric"
{
	"$basetexture" "models\player\vad36black_mesa/body"
	"$bumpmap" "models\player\vad36black_mesa/body_normal"
	
	"$surfaceprop" "flesh"

	
// -- From here down is new stuff which will only be applied if $phong is set to 1 --
    $phong 1
    $phongexponent 7
    $phongboost 1
    $phongtint "[1 1 1]"  
    $phongfresnelranges "[.4 .8 30]"

}
Handle g_taskClean[MAXPLAYERS+1];
Handle g_taskCountdown[MAXPLAYERS+1];
int g_killCount[MAXPLAYERS+1];
int g_RoundGeneration;

public Plugin:myinfo = 
{
	name = "[ZR] CSS_8Kills For Human",
	author = "wTong, [CNSR] FJH_03",

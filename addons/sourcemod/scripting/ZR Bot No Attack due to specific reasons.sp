/* Plugin Template generated by Pawn Studio */

#include <sourcemod>
#include <dhooks>
#include <zombiereloaded>

#define GAMEDATA "isotherenemy.games"

DynamicDetour hDHookByPlayer;

public Plugin myinfo =
{
	name = "[ZR] Bot No Attack due to specific reasons",
	author = "[CNSR] FJH_03",
	description = "当回合开始没有出现僵尸时，禁止Bot的敌对行为，且会随情况恢复",
	version = "1.75",
	url = "<- URL ->"
}

public OnPluginStart()
{
	Handle hConf = LoadGameConfigFile(GAMEDATA);
	if (hConf == null)
		SetFailState("[SM] Failed to load gamedata (%s.txt)", GAMEDATA);

	hDHookByPlayer = DHookCreateDetour(Address_Null, CallConv_THISCALL, ReturnType_Bool, ThisPointer_CBaseEntity);
	if (!hDHookByPlayer.SetFromConf(hConf, SDKConf_Signature, "IsOtherEnemyByPlayer"))
		SetFailState("[SM] IsOtherEnemyByPlayer signature not found");
	hDHookByPlayer.AddParam(HookParamType_CBaseEntity);
	if (!hDHookByPlayer.Enable(Hook_Pre, IsOtherEnemy_Pre))
		SetFailState("[SM] Failed to enable IsOtherEnemyByPlayer detour");

	delete hConf;

	HookEvent("round_start", RoundStart, EventHookMode_Post);
}

public OnPluginEnd()
{
	hDHookByPlayer.Disable(Hook_Pre, IsOtherEnemy_Pre);
	delete hDHookByPlayer;
}

bool g_botsNoAttackEnabled;

public void RoundStart(Handle hEvent, char[] chEvent, bool bDontBroadcast)
{
	g_botsNoAttackEnabled = true; // 启用禁止攻击
	PrintToChatAll("\x01\x03[\x04阻止Bot射击\x03]\x01 已阻止Bot开火行为！");
}


public MRESReturn IsOtherEnemy_Pre(int client, DHookReturn hReturn, Handle hParams)
{
	if (!IsClient(client, true))
		return MRES_Ignored;

	// 当有僵尸出现时，恢复正常敌对判定
	if (ZR_IsClientZombie(client) && g_botsNoAttackEnabled)
	{
		g_botsNoAttackEnabled = false;
	}

	// 只在禁止攻击模式下拦截，返回 false（不是敌人）
	if (g_botsNoAttackEnabled)
	{
		DHookSetReturn(hReturn, false);
		return MRES_Supercede;
	}

	// 恢复正常后，放行让原始函数处理
	return MRES_Ignored;
}

//检测玩家属性函数
bool:IsClient(Client, bool:Alive)
{
	return Client <= MaxClients && IsClientConnected(Client) && IsClientInGame(Client) && (Alive && IsPlayerAlive(Client));
}